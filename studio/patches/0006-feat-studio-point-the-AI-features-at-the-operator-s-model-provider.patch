+        SUPAVISE_AI_MODEL: 'llama3.1:8b',
+      }).modelId
+    ).toBe('llama3.1:8b')
+    expect(
+      resolveOpenAICall(assistant, 'gpt-6-luna', base, { SUPAVISE_AI_COMPLETION_MODEL: 'small' })
+        .modelId
+    ).toBe('gpt-6-luna')
+  })
