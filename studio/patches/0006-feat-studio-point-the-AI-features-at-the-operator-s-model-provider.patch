+    expect(resolveOpenAICall(assistant, 'gpt-6-luna', base, env).modelId).toBe('openai/gpt-4o')
+    expect(resolveOpenAICall(DEFAULT_COMPLETION_MODEL, 'gpt-5.4-nano', base, env).modelId).toBe(
+      'openai/gpt-4o-mini'
