+    const call = resolveOpenAICall(assistant, 'gpt-6-luna', base, {
+      SUPAVISE_AI_API: 'chat',
+      SUPAVISE_AI_MODEL: 'llama3.1:8b',
+    })
+    expect(call).toEqual({ modelId: 'llama3.1:8b', api: 'chat', providerOptions: {} })
+    expect(
+      resolveOpenAICall(assistant, 'gpt-6-luna', base, {
+        SUPAVISE_AI_API: 'chat',
+        SUPAVISE_AI_MODEL: 'o4-mini',
+        SUPAVISE_AI_REASONING_EFFORT: 'low',
+      }).providerOptions
+    ).toEqual({ reasoningEffort: 'low' })
+  })
+
+  it('keeps store: false on /responses, and upstream’s effort for upstream’s model', () => {
+    const call = resolveOpenAICall(assistant, 'gpt-6-luna', base, { SUPAVISE_AI_API: 'responses' })
+    expect(call.providerOptions).toEqual({ store: false, reasoningEffort: 'medium' })
+    expect(
+      resolveOpenAICall(assistant, 'gpt-6-luna', base, {
+        SUPAVISE_AI_MODEL: 'my-deployment',
+        SUPAVISE_AI_API: 'responses',
+      }).providerOptions
+    ).toEqual({ store: false })
+  })
+
+  it('does not change the shared base options', () => {
+    resolveOpenAICall(assistant, 'gpt-6-luna', base, {
+      SUPAVISE_AI_API: 'chat',
+      SUPAVISE_AI_REASONING_EFFORT: 'high',
+    })
+    expect(base).toEqual({ store: false })
+  })
+
+  it('ignores values that are not a model name, an API or an effort', () => {
+    const call = resolveOpenAICall(assistant, 'gpt-6-luna', base, {
+      SUPAVISE_AI_MODEL: 'two words',
+      SUPAVISE_AI_API: 'completions',
+      SUPAVISE_AI_REASONING_EFFORT: 'extreme',
+    })
+    expect(call).toEqual({
+      modelId: 'gpt-6-luna',
+      api: 'responses',
+      providerOptions: { store: false, reasoningEffort: 'medium' },
+    })
+  })
+})
+
+describe('getConfiguredAssistantModel', () => {
+  it('names the operator’s model, and nothing without one', () => {
+    expect(getConfiguredAssistantModel({})).toBeUndefined()
+    expect(getConfiguredAssistantModel({ SUPAVISE_AI_MODEL: ' openai/gpt-4o ' })).toBe(
+      'openai/gpt-4o'
+    )
+    expect(getConfiguredAssistantModel({ SUPAVISE_AI_MODEL: '' })).toBeUndefined()
+    expect(getConfiguredAssistantModel({ SUPAVISE_AI_MODEL: 'a b' })).toBeUndefined()
+  })
+})
diff --git a/apps/studio/lib/ai/self-hosted-model.ts b/apps/studio/lib/ai/self-hosted-model.ts
new file mode 100644
index 0000000..6803dec
--- /dev/null
+++ b/apps/studio/lib/ai/self-hosted-model.ts
@@ -0,0 +1,74 @@
+import { DEFAULT_COMPLETION_MODEL, LOGS_REWRITE_MODEL, type OpenAIModelEntry } from './model.utils'
+
+/**
+ * The model provider of a self-hosted deployment, from the server's environment.
+ *
+ * A node points Studio at any API that speaks OpenAI's protocol (OpenAI, OpenRouter, LiteLLM,
+ * a local Ollama, ...). `OPENAI_API_KEY` and `OPENAI_BASE_URL` are read by `@ai-sdk/openai`
+ * itself. The variables below choose what upstream fixes in code: the model names, which are
+ * OpenAI's, the API that carries the request, and the reasoning effort.
+ *
+ * - `SUPAVISE_AI_MODEL`: the model of the Assistant's chat (replaces the one picked in the UI).
+ * - `SUPAVISE_AI_COMPLETION_MODEL`: the model of the small calls (titles, filters, cron, policies,
+ *   inline completion). Falls back to `SUPAVISE_AI_MODEL`.
+ * - `SUPAVISE_AI_API`: `chat` for /chat/completions, which every gateway offers; anything else
+ *   keeps upstream's /responses.
+ * - `SUPAVISE_AI_REASONING_EFFORT`: sent with every request when set. A model chosen through the
+ *   variables above gets no effort otherwise, because upstream's efforts belong to OpenAI's models.
+ *
+ * They are read on the server for each request and never reach the browser. Without any of them
+ * every function here answers as upstream does.
+ */
+
+const MODEL_NAME = /^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$/
+const REASONING_EFFORTS = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']
+
+type Env = Record<string, string | undefined>
+
+function modelFromEnv(value: string | undefined): string | undefined {
+  const name = value?.trim()
+  return name && MODEL_NAME.test(name) ? name : undefined
+}
+
+/** The model of the Assistant's chat the operator chose, if any. */
+export function getConfiguredAssistantModel(env: Env = process.env): string | undefined {
+  return modelFromEnv(env.SUPAVISE_AI_MODEL)
+}
+
+export type OpenAICall = {
+  modelId: string
+  /** `chat` is /chat/completions, `responses` is /responses (upstream's choice). */
+  api: 'chat' | 'responses'
+  providerOptions: Record<string, any>
+}
+
+/**
+ * The model, API and provider options of a call to the `openai` provider. `chosenModelId` and
+ * `baseProviderOptions` are what upstream would use.
+ */
+export function resolveOpenAICall(
+  modelEntry: OpenAIModelEntry | undefined,
+  chosenModelId: string,
+  baseProviderOptions: Record<string, any>,
+  env: Env = process.env
+): OpenAICall {
+  const isCompletion = modelEntry === DEFAULT_COMPLETION_MODEL || modelEntry === LOGS_REWRITE_MODEL
+  const assistantModel = modelFromEnv(env.SUPAVISE_AI_MODEL)
+  const modelOverride = isCompletion
+    ? (modelFromEnv(env.SUPAVISE_AI_COMPLETION_MODEL) ?? assistantModel)
+    : assistantModel
+  const api = env.SUPAVISE_AI_API === 'chat' ? 'chat' : 'responses'
+  const effort = env.SUPAVISE_AI_REASONING_EFFORT?.trim()
+  const effortOverride = effort && REASONING_EFFORTS.includes(effort) ? effort : undefined
+
+  // Upstream: the entry's own effort on top of the base options.
+  const reasoningEffort =
+    effortOverride ?? (modelOverride ? undefined : modelEntry?.reasoningEffort)
+  // `store: false` keeps OpenAI from retaining a /responses request; /chat/completions stores
+  // nothing by default, and a gateway may reject a field it does not know.
+  const options = { ...baseProviderOptions }
+  if (api === 'chat') delete options.store
+  if (reasoningEffort) options.reasoningEffort = reasoningEffort
+
+  return { modelId: modelOverride ?? chosenModelId, api, providerOptions: options }
+}
